# Supabase（第2段：マジックリンク認証＋クラウド保存）
# 値は Supabase の Project Settings → API から取得して .env.local にコピーする。
# anon public キーはフロントで使う公開キー。service_role キーは絶対に置かない・公開しない。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# デモ用アカウント（任意）。設定すると /?demo=1 に「デモとして入る」ボタンが出る。
# メールアドレスはブラウザから見える。パスワードはサーバー限定（NEXT_PUBLIC_ を付けない）。
NEXT_PUBLIC_DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=your-demo-password
